generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  nickname     String   @unique
  passwordHash String
  role         String   @default("user") // "user" 用户 | "admin" 管理员（开发者）| "owner" 开发管理员（站长）（仅本人）
  createdAt    DateTime @default(now())
}

model Message {
  id          Int       @id @default(autoincrement())
  content     String
  isAnonymous Boolean   @default(false)
  userId      Int?
  nickname    String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime? // 逻辑删除标记：为空表示未删除，有值表示已删除的时间
}

// 游戏存档：每用户每游戏仅一个（D3）。state 为平台无关纯数据 JSON，保证 PC/移动端可交叉续玩（D7）
model GameSave {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameKey   String   // 对应 engine.key，如 "climb"
  state     String   // JSON 序列化的游戏状态（不含 DOM/Canvas 引用）
  score     Int?     // 暂存时的当前进度/分数
  platform  String   @default("pc") // "pc" | "mobile"，记录上次存档端（D6）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, gameKey])
  @@index([gameKey])
}

// 一局结束 = 一条记录；历史与排行榜同源（排行榜=按用户取最佳派生）
model GameRecord {
  id         Int      @id @default(autoincrement())
  userId     Int
  gameKey    String
  score      Int      // 排序键（由 engine.score 计算，语义各游戏自定，D8）
  detail     String?  // JSON：每游戏自定义明细（用时/步数/难度…），供榜单/历史展示
  platform   String   @default("pc") // "pc" | "mobile"，D6 榜单展示
  finishedAt DateTime @default(now())
  @@index([gameKey, score])
  @@index([userId, gameKey])
}

// 福利类型：由管理员维护的卡种（如「加班卡」「减班卡」）。被粉丝持有时不可删除
// isDrawCount：标记为「抽奖次数」类型，粉丝自助抽奖时自动扣减，主播端显示扣除记录
model BenefitType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isDrawCount Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 粉丝：站内粉丝档案，仅 nickname 必填，其余三项可选
model Fan {
  id            Int      @id @default(autoincrement())
  nickname      String
  userId        Int?     // 关联的系统内账号（User.id），未关联时为空
  systemAccount String?  // 系统内账号昵称快照（冗余存储，用户改名不追溯）
  douyinAccount String?
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId])
}

// 粉丝持有的卡：同一粉丝的同一类型至多一条记录，amount 为剩余数量
model FanBenefit {
  id        Int      @id @default(autoincrement())
  fanId     Int
  typeId    Int
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt
  @@unique([fanId, typeId])
  @@index([typeId])
}

// 卡的增减流水：每次调整都留痕（理由 + 时间 + 操作人 + 变动后余额），只增不改不删
model BenefitLog {
  id           Int      @id @default(autoincrement())
  fanId        Int
  typeId       Int
  fanNickname  String   // 粉丝昵称快照：粉丝被删除后流水仍可读
  typeName     String   // 类型名快照
  delta        Int      // 正数为增加，负数为减少
  balance      Int      // 变动后的卡数量
  reason       String
  operatorId   Int?     // 操作人（User.id）
  operatorName String?
  createdAt    DateTime @default(now())
  @@index([fanId, createdAt])
  @@index([typeId])
}

// 常用理由：增减卡时一键带入的理由短语（如「活动奖励」「直播抽奖」），由管理员维护
// type：common 公共（增加/减少都可选）/ add 仅增加时用 / sub 仅减少时用；缺省 common，保证历史数据平滑升级
model BenefitReason {
  id        Int      @id @default(autoincrement())
  text      String   @unique
  type      String   @default("common")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 上传文件：任何功能需要「挂附件」都建一条 UploadedFile，把 fileId 存在业务表字段上（id 关联，不用外键）
// storageKey 为磁盘相对路径（基于上传根目录），迁移存储后端时只改 fileService，不动业务表
model UploadedFile {
  id           Int      @id @default(autoincrement())
  originalName String   // 原始文件名（展示用）
  mimeType     String   // 客户端申报的 Content-Type（展示用，不可信）
  size         Int      // 字节数
  ext          String   // 规范化小写扩展名（含点，如 ".png"），磁盘文件以此命名
  storageKey   String   @unique // 磁盘相对路径，如 "2026/11/11/xxx.png"
  category     String   @default("general") // 业务分类（如 "general"/"avatar"），便于按功能管理与清理
  uploaderId   Int?     // 上传人（User.id）
  createdAt    DateTime @default(now())
  @@index([category])
}

// 抽奖礼品：weight 为权重（非负整数），实际中奖率 = weight / Σ(可用礼品 weight)
// stock：剩余数量，-1 表示无限制；stock = 0 或 weight = 0 的礼品不会被抽中
// benefitTypeId：关联 BenefitType.id（系统自带礼品，从福利类型同步过来；手动新增为 null）
// 与福利模块一致不使用 Prisma relation，跨表数据用二次查询手工拼接
model RafflePrize {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  benefitTypeId Int?     @unique // 关联 BenefitType.id（系统自带，不可编辑/删除）
  imageFileId   Int?     // 关联 UploadedFile.id（可选，图片展示用）
  weight        Int      @default(1) // 中奖权重：0 表示不参与抽奖
  stock         Int      @default(-1) // 剩余数量：-1 无限制，0 表示已抽完
  enabled       Boolean  @default(true) // 停用的礼品不进入奖池
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([enabled, stock])
  @@index([benefitTypeId])
}

// 抽奖记录：只增不改不删，存礼品名/粉丝名快照，礼品或粉丝被删后记录仍可读
// drawnBy："host" 主播帮抽 | "self" 粉丝自助抽（粉丝端只显示 self）
model RaffleRecord {
  id           Int      @id @default(autoincrement())
  prizeId      Int
  prizeName    String   // 礼品名快照
  fanId        Int?     // 抽奖粉丝（Fan.id），未指定时为 null
  fanNickname  String?  // 粉丝昵称快照
  operatorId   Int?     // 操作人（User.id）
  operatorName String?
  drawnBy      String   @default("host")
  createdAt    DateTime @default(now())
  @@index([prizeId, createdAt])
  @@index([fanId, createdAt])
  @@index([drawnBy, createdAt])
}
